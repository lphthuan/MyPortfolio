# ==============================================================================
# lphThuan.dev - LiteSpeed / Apache URL Rewrite Configuration
# ==============================================================================
RewriteEngine On
RewriteBase /

# Prevent directory browsing
Options -Indexes

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Clean URL for single project: /project/SLUG -> project-detail.php?slug=SLUG
RewriteRule ^project/([^/]+)/?$ project-detail.php?slug=$1 [L,QSA,NC]

# Clean URL for projects list: /projects -> projects.php
RewriteRule ^projects/?$ projects.php [L,QSA,NC]
